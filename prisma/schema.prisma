// MatchField - Prisma Schema (MongoDB)
// Sports venue and field booking platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum UserRole {
  PLAYER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum FieldType {
  INDOOR
  OUTDOOR
}

enum FieldModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  UPCOMING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  ORGANIZER  // Organizer pays full amount
  SPLIT      // Equal split among all players
  MIXED      // Custom amounts per player
}

enum PaymentStatus {
  PENDING
  PAID
}

// ============== MODELS ==============

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  phone          String?
  dateOfBirth    DateTime? @map("date_of_birth")
  gender         String?
  location       String?
  avatar         String?
  role           UserRole  @default(PLAYER)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Owner verification (for OWNER role)
  verificationStatus VerificationStatus? @default(NOT_SUBMITTED) @map("verification_status")
  idFrontUrl         String?            @map("id_front_url")
  idBackUrl          String?            @map("id_back_url")
  verifiedAt         DateTime?          @map("verified_at")

  /// UI settings keyed by role: { "owner": { ... }, "player": { ... } }
  preferences Json? @map("preferences")

  // Relations
  ownedFields         Field[]             @relation("FieldOwner")
  reviews             Review[]
  favorites           Favorite[]
  organizedBookings   Booking[]            @relation("BookingOrganizer")
  bookingParticipants BookingParticipant[]
  sentMessages        Message[]            @relation("SentMessages")
  conversationsAsUser1 Conversation[]     @relation("ConversationUser1")
  conversationsAsUser2 Conversation[]     @relation("ConversationUser2")
  userNotifications   UserNotification[]

  @@map("users")
}

model Field {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  sport       String    // Football, Tennis, Basketball, Padel, Volleyball, Ice Hockey, etc.
  description String?
  capacity    Int?
  type        FieldType @default(OUTDOOR) // INDOOR | OUTDOOR
  location    String
  address     String?
  city        String?
  district    String?
  latitude    Float?
  longitude   Float?
  phone       String?
  pricePerHour Int      @map("price_per_hour") // in smallest currency unit (e.g. kuruş for TRY)
  amenities   String[]  @default([])
  features    String[]  @default([]) // e.g. ["Parking", "Changing Rooms", "Water Station"]
  highlights  String[]  @default([])
  images      String[]  @default([]) // URLs of images
  schedule    Json?
  bookingType String?   @map("booking_type")
  advanceBooking String? @map("advance_booking")
  cancellationPolicy String? @map("cancellation_policy")
  visibilityRequested Boolean? @map("visibility_requested")
  /// Optional URLs for owner-submitted verification files (shown in admin review).
  ownershipDocumentUrl String? @map("ownership_document_url")
  licensesDocumentUrl  String? @map("licenses_document_url")
  rating      Float?    @default(0) // computed from reviews
  reviewCount Int       @default(0) @map("review_count")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Admin moderation / approval workflow (optional for backward-compat with existing data)
  moderationStatus FieldModerationStatus? @default(PENDING) @map("moderation_status")
  moderationReason String?                @map("moderation_reason")
  moderatedAt      DateTime?              @map("moderated_at")
  moderatedById    String?                @map("moderated_by_id") @db.ObjectId

  ownerId     String    @map("owner_id") @db.ObjectId
  owner       User      @relation("FieldOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Relations
  reviews           Review[]
  bookings          Booking[]
  favorites         Favorite[]
  unavailableDates  FieldUnavailableDate[]

  @@map("fields")
}

model FieldUnavailableDate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  fieldId   String   @map("field_id") @db.ObjectId
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fieldId, date])
  @@map("field_unavailable_dates")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int      // 1-5
  reviewText String   @map("review_text")
  context    String?  // e.g. "Played 5v5 last week"
  createdAt  DateTime @default(now()) @map("created_at")

  fieldId   String   @map("field_id") @db.ObjectId
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fieldId, userId])
  @@map("field_reviews")
}

model Booking {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  date                   DateTime
  timeSlotStart          String         @map("time_slot_start") // e.g. "18:00"
  timeSlotEnd            String         @map("time_slot_end")   // e.g. "20:00"
  timeSlotRanges         Json?          @map("time_slot_ranges") // [{start,end},...] for non-contiguous slots
  totalCost              Int            @map("total_cost")      // in smallest currency unit
  paymentMethod          PaymentMethod @map("payment_method")
  status                 BookingStatus  @default(PENDING)
  organizerPaymentStatus PaymentStatus? @map("organizer_payment_status") // for organizer's share
  mixedPaymentDistribution Json?       @map("mixed_payment_distribution") // { [userId]: amount } when paymentMethod = MIXED
  teamSize               Int?          @map("team_size")       // total players (organizer + participants)
  createdAt              DateTime       @default(now()) @map("created_at")
  confirmedAt            DateTime?      @map("confirmed_at")

  fieldId      String   @map("field_id") @db.ObjectId
  field        Field    @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  organizerId  String   @map("organizer_id") @db.ObjectId
  organizer    User     @relation("BookingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)

  participants BookingParticipant[]

  @@map("bookings")
}

model BookingParticipant {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentAmount  Int?          @map("payment_amount") // assigned amount for split/mixed
  createdAt      DateTime      @default(now()) @map("created_at")

  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@map("booking_participants")
}

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  fieldId   String   @map("field_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId])
  @@map("favorites")
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  blockedAt DateTime? @map("blocked_at")
  starredAt DateTime? @map("starred_at")
  isSupportThread Boolean? @default(false) @map("is_support_thread")

  user1Id String @map("user1_id") @db.ObjectId
  user1   User   @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id String @map("user2_id") @db.ObjectId
  user2   User   @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String   @default("")
  attachments Json?  @map("attachments") // [{ url, mimeType, originalName, size }]
  createdAt DateTime @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  conversationId String       @map("conversation_id") @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.ObjectId
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  message      String
  audience     String   @default("all")   // all, players, owners, admins, private
  channels     String[] @default(["in-app"])  // in-app, email
  targetUserId String?  @map("target_user_id") @db.ObjectId
  sentById     String?  @map("sent_by_id") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  userNotifications UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  userId         String      @map("user_id") @db.ObjectId
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String      @map("notification_id") @db.ObjectId
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}
