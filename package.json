    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "test:api": "node scripts/api-smoke-full.js",
    "test:critical": "node scripts/test-critical-c1-c4.js",
    "test:high": "node scripts/test-high-h1-h8.js",
    "test:security": "node scripts/test-security.js",
    "test:preferences": "node scripts/test-preferences.js",
    "test:palestine": "node scripts/test-palestine-sweep.js",
    "test:no-chat": "node scripts/test-no-chat.js",
    "test:storage": "node scripts/test-storage.js",
    "migrate:base64-docs": "node scripts/migrate-base64-documents.js --dry-run",
    "migrate:storage": "node scripts/migrate-storage-to-supabase.js --dry-run"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
