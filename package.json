{
  "name": "matchfield",
  "version": "1.0.0",
  "description": "MatchField - Sports venue and field booking platform",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
