# MatchField — PostgreSQL (Supabase) via Prisma

# Transaction pooler (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session / direct connection (migrations) — never expose to frontend
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Required — long random secret (min 32 chars in production)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional — access token TTL (default 1h). Refresh tokens default to 30 days.
# JWT_ACCESS_TTL="1h"
# JWT_REFRESH_TTL_MS=2592000000

# bcrypt cost (default 12)
# BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed for CORS + Socket.IO (required in production)
# Development defaults to localhost if unset.
# ALLOWED_ORIGINS="http://localhost:3000,https://matchfield.example"

# Behind reverse proxy: set TRUST_PROXY=1 so rate limits see client IP from X-Forwarded-For
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# Rate limits (optional overrides)
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_DISABLED=1

# Optional — base URL for password reset links
# APP_BASE_URL="http://localhost:3000"

# Optional — public support contact shown on Contact Us
# PUBLIC_SUPPORT_EMAIL="MatchField@gmail.com"
# PUBLIC_SUPPORT_WHATSAPP="+90 (5xx) xxx xx xx"
# PUBLIC_SUPPORT_PHONE="+90 (212) xxx xx xx. 09:00-22:00"

# Server port
# PORT=3000
# NODE_ENV=development
