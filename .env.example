# MatchField — PostgreSQL (Supabase) via Prisma

# Transaction pooler (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session / direct connection (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Required — JWT for login / Socket.IO
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Optional — access token TTL (default 1h). Refresh tokens default to 30 days.
# JWT_ACCESS_TTL="1h"
# JWT_REFRESH_TTL_MS=2592000000

# Optional — base URL for password reset links
# APP_BASE_URL="http://localhost:3000"

# Optional — public support contact shown on Contact Us
# PUBLIC_SUPPORT_EMAIL="MatchField@gmail.com"
# PUBLIC_SUPPORT_WHATSAPP="+90 (5xx) xxx xx xx"
# PUBLIC_SUPPORT_PHONE="+90 (212) xxx xx xx. 09:00-22:00"
