# Database URL for Prisma (MongoDB)
# Copy this file to .env and set your own DATABASE_URL

# MongoDB Atlas (cloud):
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/matchfield?retryWrites=true&w=majority"

# Local MongoDB:
# DATABASE_URL="mongodb://localhost:27017/matchfield"

# Required — server will not start without this (JWT for login)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
